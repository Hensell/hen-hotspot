<Window x:Class="HenHotspot.DomainRemovalDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Eliminar dominio" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 ShowInTaskbar="False" Background="#FFFFFF" FontFamily="Segoe UI Variable, Segoe UI" Foreground="#172723"
 UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <StackPanel Margin="28,24,28,26">
  <TextBlock Text="¿Eliminar este dominio?" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock x:Name="DomainText" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8"/>
  <TextBlock x:Name="EffectText" Style="{StaticResource Body}"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
   <Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" MinWidth="104" Margin="0,0,10,0"/>
   <Button Content="Eliminar" Background="#A23F36" Foreground="White" BorderThickness="0" MinWidth="104" Click="Confirm_Click"/>
  </StackPanel>
 </StackPanel>
</Window>
